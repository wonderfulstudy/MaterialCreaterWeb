{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "baseUrl": "",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@mc/core/*": ["../MaterialCreaterApp/packages/core/src/*"],
      "@/*": ["src/*"],
      "@app-config": ["../MaterialCreaterServer/config/app.config.json"]
    },
    "types": ["node", "jest"]
  },
  "include": ["src", "types"],
  "compileOnSave": false
}
